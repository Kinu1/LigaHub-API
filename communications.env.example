# Resend dedicado; o domínio de EMAIL_FROM deve estar verificado no painel Resend.
# Configure também CREDENTIALS_ENCRYPTION_KEY (32 bytes base64), sem reutilizar exemplos em produção.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
# EMAIL_PROVIDER e SMTP_* existentes continuam controlando os emails anteriores.
# Webhook público: POST /notifications/resend/webhook, tipos sent/delivered/delivery_delayed/bounced/complained/failed/suppressed.
# Desabilite open/click tracking no painel do domínio Resend; a aplicação ignora esses eventos.
