POSTGRES_USER=ligahub
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ligahub

DATABASE_URL="postgresql://ligahub:troque-esta-senha@127.0.0.1:5433/ligahub?schema=public"

PORT=3000
JWT_SECRET=SUBSTITUA_COM_NPM_RUN_ENV_INIT
CREDENTIALS_ENCRYPTION_KEY=SUBSTITUA_COM_NPM_RUN_ENV_INIT
API_DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:3001

# Defina localmente para criar o primeiro administrador; nunca versione a senha.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Configure após criar uma aplicação de Checkout Transparente no Mercado Pago.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_TEST_MODE=true
# Conta fixa de teste: não utiliza Client Secret nem substitui OAuth em produção.
MERCADO_PAGO_TEST_ACCESS_TOKEN=
MERCADO_PAGO_TEST_PUBLIC_KEY=
MERCADO_PAGO_TEST_OWNER_EMAIL=
MERCADO_PAGO_REDIRECT_URI=https://sua-api.example/payments/accounts/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_NOTIFICATION_URL=https://sua-api.example/payments/webhook
PAYMENT_RECONCILIATION_ENABLED=true

# Confirmação por e-mail: habilite somente depois de configurar o provedor.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:3001
