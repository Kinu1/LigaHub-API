generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicEvent {
  id           String   @id @db.Uuid
  title        String
  priceInCents Int
  capacity     Int
  status       String   @default("draft")
  createdAt    DateTime @default(now())

  publicId             String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId              String?        @db.Uuid
  owner                User?          @relation(fields: [ownerId], references: [id])
  description          String         @default("")
  location             String         @default("")
  logoImage            String?
  bannerImage          String?
  startsAt             DateTime?
  endsAt               DateTime?
  registrationStartsAt DateTime?
  registrationDeadline DateTime?
  reservationMinutes   Int            @default(15)
  form                 Json           @default("[]")
  registrationTypes    Json           @default("[]")
  registrations        Registration[]
  communicationCampaigns CommunicationCampaign[]

  @@map("academic_events")
}

enum UserRole {
  admin
  organizer
}

enum RegistrationOrigin {
  public
  manual
  historical
}

model User {
  id           String   @id @db.Uuid
  name         String
  email        String   @unique
  role         UserRole
  passwordHash String
  createdAt    DateTime @default(now())

  active          Boolean          @default(true)
  tokenVersion    Int              @default(0)
  events          AcademicEvent[]
  paymentAccounts PaymentAccount[]
  oauthStates     OAuthState[]
  auditLogs       AuditLog[]
  communicationCampaigns CommunicationCampaign[]

  @@map("users")
}

model Registration {
  id                      String           @id @default(uuid()) @db.Uuid
  eventId                 String           @db.Uuid
  event                   AcademicEvent    @relation(fields: [eventId], references: [id])
  name                    String
  email                   String
  participantCpfEncrypted String?
  answers                 Json
  formSnapshot            Json
  priceInCents            Int
  registrationTypeId      String?
  registrationTypeName    String?
  status                  String           @default("reserved")
  reviewReason            String?
  reservationExpiresAt    DateTime
  manageTokenHash         String
  manageTokenEncrypted    String?
  accessLinks             RegistrationAccessLink[]
  statusTokenHash         String?
  statusTokenExpiresAt    DateTime?
  suspendedAt             DateTime?
  cancellationRequestedAt DateTime?
  createdAt               DateTime         @default(now())
  payments                PaymentAttempt[]
  confirmationEmails      EmailOutbox[]
  communicationRecipients CommunicationRecipient[]

  origin                  RegistrationOrigin @default(public)
  manualAuthorId          String?            @db.Uuid
  manualCreatedAt         DateTime?

  @@unique([eventId, email])
  @@index([eventId, status, reservationExpiresAt])
  @@index([origin])
  @@index([manualAuthorId])
  @@map("registrations")
}

model BrowserSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenVersion Int
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId])
  @@map("browser_sessions")
}

model RegistrationAccessLink {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @db.Uuid
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  email AccessEmailOutbox?
  @@map("registration_access_links")
}

model PaymentAccount {
  id                    String           @id @default(uuid()) @db.Uuid
  ownerId               String           @db.Uuid
  owner                 User             @relation(fields: [ownerId], references: [id])
  merchantId            String
  isTest                Boolean          @default(false)
  publicKey             String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now())
  payments              PaymentAttempt[]

  @@index([ownerId, active])
  @@map("payment_accounts")
}

model OAuthState {
  id                String    @id @default(uuid()) @db.Uuid
  stateHash         String    @unique
  ownerId           String    @db.Uuid
  owner             User      @relation(fields: [ownerId], references: [id])
  verifierEncrypted String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@map("oauth_states")
}

model PaymentAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  registrationId    String         @db.Uuid
  registration      Registration   @relation(fields: [registrationId], references: [id])
  accountId         String         @db.Uuid
  account           PaymentAccount @relation(fields: [accountId], references: [id])
  idempotencyKey    String         @unique @db.Uuid
  requestHash       String
  providerPaymentId String?        @unique
  providerApi       String         @default("payments")
  providerRequestEncrypted String?
  // Nulo preserva a incerteza dos registros anteriores à marcação de envio.
  submissionStarted Boolean?
  payerEncrypted    String?
  // Snapshot de destino somente para novas cobranças Pix na conta da plataforma.
  payoutOwnerId String? @db.Uuid
  payoutDestinationEncrypted String?
  payout PixPayout?
  method            String
  installments      Int
  amountInCents     Int
  registrationAmountInCents Int?
  platformFeeInCents Int?
  processingFeeInCents Int?
  pricingSnapshot Json?
  status            String         @default("created")
  statusDetail      String?
  checkout          Json?
  providerUpdatedAt DateTime?
  lastSyncedAt      DateTime?
  lastSyncAttemptAt DateTime?
  lastSyncSucceededAt DateTime?
  lastSyncErrorCode String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt


  @@index([status, updatedAt])
  @@index([lastSyncErrorCode])
  @@map("payment_attempts")
}

model OrganizerPixDestination {
  ownerId      String    @id @db.Uuid
  id           String    @unique @default(uuid()) @db.Uuid
  keyType      String
  keyEncrypted String
  fingerprint  String
  approvedAt   DateTime?
  approvedBy   String?   @db.Uuid
  updatedAt    DateTime  @updatedAt

  @@map("organizer_pix_destinations")
}

model PixPayout {
  id                    String         @id @default(uuid()) @db.Uuid
  paymentId             String         @unique @db.Uuid
  payment               PaymentAttempt @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  // Uma inscrição não pode gerar dois repasses, mesmo com várias aprovações.
  registrationId        String         @unique @db.Uuid
  ownerId               String         @db.Uuid
  destinationEncrypted  String
  amountInCents         Int
  status                String         @default("pending")
  reason                String?
  submittedAt           DateTime?
  manualReservedBy      String?        @db.Uuid
  manualReservedAt      DateTime?
  manualReceiptEncrypted String?
  manualReceiptHash     String?        @unique
  manualPaidAt          DateTime?
  providerPayoutId      String?        @unique
  providerTransactionId String?        @unique
  leaseId               String?        @db.Uuid
  leaseExpiresAt        DateTime?
  nextAttemptAt         DateTime       @default(now())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([ownerId, createdAt])
  @@map("pix_payouts")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model EmailOutbox {
  id               String       @id @default(uuid()) @db.Uuid
  registrationId   String       @unique @db.Uuid
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  payloadEncrypted String?
  status           String       @default("pending")
  attempts         Int          @default(0)
  nextAttemptAt    DateTime     @default(now())
  firstAttemptAt   DateTime?
  leaseId          String?      @db.Uuid
  leaseExpiresAt   DateTime?
  providerId       String?
  sentAt           DateTime?
  createdAt        DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model BackgroundJob {
  name String @id
  leaseId String? @db.Uuid
  leaseExpiresAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  lastSucceededAt DateTime?
  lastFailedAt DateTime?
  errorCode String?
  status String?
  processedCount Int @default(0)
  succeededCount Int @default(0)
  failedCount Int @default(0)
  skippedCount Int @default(0)
  runCount Int @default(0)
  failureCount Int @default(0)

  @@map("background_jobs")
}

model AccessEmailOutbox {
  id String @id @default(uuid()) @db.Uuid
  linkId String @unique @db.Uuid
  link RegistrationAccessLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  payloadEncrypted String?
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime?
  leaseId String? @db.Uuid
  leaseExpiresAt DateTime?
  providerId String?
  sentAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([expiresAt])
  @@map("access_email_outbox")
}

enum CommunicationStatus {
  draft
  sending
  sent
  failed
}

enum CommunicationAudience {
  all_active
  confirmed_only
  categories
}

enum RecipientStatus {
  pending
  queued
  processing
  accepted
  delivered
  delayed
  failed
  unconfirmed_after24h
  skipped
}

enum AttachmentStatus {
  uploading
  ready
  failed
  expired
}

model CommunicationCampaign {
  id                String    @id @default(uuid()) @db.Uuid
  eventId           String    @db.Uuid
  event             AcademicEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ownerId           String    @db.Uuid
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  subject           String    @db.VarChar(255)
  htmlContent       String    @db.Text
  textContent       String    @db.Text
  audienceType      CommunicationAudience @default(all_active)
  audienceCategoryIds String[]  @default([])
  confirmedOnly Boolean @default(false)
  contentEncrypted String? @db.Text
  envelopeEncrypted String? @db.Text
  snapshotCount Int @default(0)
  completedAt DateTime?
  status            CommunicationStatus @default(draft)
  idempotencyKey    String    @db.Uuid
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  attachments       CommunicationAttachment[]
  recipients        CommunicationRecipient[]


  @@index([eventId])
  @@index([ownerId])
  @@index([idempotencyKey])
  @@unique([eventId, idempotencyKey])
  @@map("communication_campaigns")
}

model CommunicationAttachment {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @db.Uuid
  campaign        CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  filename        String    @db.VarChar(255)
  mimeType        String    @db.VarChar(100)
  sizeBytes       BigInt
  checksum        String    @db.VarChar(64)
  status          AttachmentStatus @default(uploading)
  encryptedPayload String?   @db.Text
  uploadedAt      DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  chunks          CommunicationAttachmentChunk[]
  totalChunks Int

  @@index([campaignId])
  @@index([status, expiresAt])
  @@map("communication_attachments")
}

model CommunicationAttachmentChunk {
  id            String    @id @default(uuid()) @db.Uuid
  attachmentId  String    @db.Uuid
  attachment    CommunicationAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  chunkIndex    Int
  dataBase64    String    @db.Text
  checksum      String    @db.VarChar(64)
  createdAt     DateTime  @default(now())

  @@unique([attachmentId, chunkIndex])
  @@map("communication_attachment_chunks")
}

model CommunicationRecipient {
  webhookEvents CommunicationWebhookEvent[]
  id                String         @id @default(uuid()) @db.Uuid
  campaignId        String         @db.Uuid
  campaign          CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  registrationId    String         @db.Uuid
  registration      Registration   @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  email             String         @db.VarChar(255)
  name              String         @db.VarChar(255)
  status            RecipientStatus @default(pending)
  attempts          Int            @default(0)
  leaseId           String?        @db.Uuid
  leaseExpiresAt    DateTime?
  providerId        String?        @db.VarChar(255)
  acceptedAt        DateTime?
  firstAttemptAt    DateTime?
  lastAttemptAt     DateTime?
  nextAttemptAt DateTime @default(now())
  deliveredAt       DateTime?
  errorCode         String?        @db.VarChar(100)
  errorDetail       String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([campaignId, registrationId])
  @@index([campaignId])
  @@index([status, nextAttemptAt])
  @@index([leaseId])
  @@index([providerId])
  @@map("communication_recipients")
}

model CommunicationWebhookEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  svixId               String   @unique @db.VarChar(255)
  eventType            String   @db.VarChar(100)
  providerId String @db.VarChar(255)
  payloadJson          Json
  receivedAt           DateTime @default(now())
  processedAt          DateTime?
  matchedRecipientId   String?  @db.Uuid
  matchedRecipient     CommunicationRecipient? @relation(fields: [matchedRecipientId], references: [id], onDelete: SetNull)
  reconciliationStatus String   @default("unmatched") @db.VarChar(50)

  @@index([receivedAt])
  @@index([matchedRecipientId])
  @@index([reconciliationStatus])
  @@index([providerId])
  @@map("communication_webhook_events")
}
