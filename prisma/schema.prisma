generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicEvent {
  id           String   @id @db.Uuid
  title        String
  priceInCents Int
  capacity     Int
  status       String   @default("draft")
  createdAt    DateTime @default(now())

  publicId             String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId              String?        @db.Uuid
  owner                User?          @relation(fields: [ownerId], references: [id])
  description          String         @default("")
  location             String         @default("")
  startsAt             DateTime?
  endsAt               DateTime?
  registrationDeadline DateTime?
  reservationMinutes   Int            @default(15)
  form                 Json           @default("[]")
  registrations        Registration[]

  @@map("academic_events")
}

enum UserRole {
  admin
  organizer
}

model User {
  id           String   @id @db.Uuid
  name         String
  email        String   @unique
  role         UserRole
  passwordHash String
  createdAt    DateTime @default(now())

  active          Boolean          @default(true)
  tokenVersion    Int              @default(0)
  events          AcademicEvent[]
  paymentAccounts PaymentAccount[]
  oauthStates     OAuthState[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Registration {
  id                      String           @id @default(uuid()) @db.Uuid
  eventId                 String           @db.Uuid
  event                   AcademicEvent    @relation(fields: [eventId], references: [id])
  name                    String
  email                   String
  answers                 Json
  formSnapshot            Json
  priceInCents            Int
  status                  String           @default("reserved")
  reservationExpiresAt    DateTime
  manageTokenHash         String
  statusTokenHash         String?
  statusTokenExpiresAt    DateTime?
  suspendedAt             DateTime?
  cancellationRequestedAt DateTime?
  createdAt               DateTime         @default(now())
  payments                PaymentAttempt[]
  confirmationEmails      EmailOutbox[]

  @@unique([eventId, email])
  @@index([eventId, status, reservationExpiresAt])
  @@map("registrations")
}

model PaymentAccount {
  id                    String           @id @default(uuid()) @db.Uuid
  ownerId               String           @db.Uuid
  owner                 User             @relation(fields: [ownerId], references: [id])
  merchantId            String
  isTest                Boolean          @default(false)
  publicKey             String
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now())
  payments              PaymentAttempt[]

  @@index([ownerId, active])
  @@map("payment_accounts")
}

model OAuthState {
  id                String    @id @default(uuid()) @db.Uuid
  stateHash         String    @unique
  ownerId           String    @db.Uuid
  owner             User      @relation(fields: [ownerId], references: [id])
  verifierEncrypted String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@map("oauth_states")
}

model PaymentAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  registrationId    String         @db.Uuid
  registration      Registration   @relation(fields: [registrationId], references: [id])
  accountId         String         @db.Uuid
  account           PaymentAccount @relation(fields: [accountId], references: [id])
  idempotencyKey    String         @unique @db.Uuid
  requestHash       String
  providerPaymentId String?        @unique
  method            String
  installments      Int
  amountInCents     Int
  status            String         @default("created")
  statusDetail      String?
  checkout          Json?
  providerUpdatedAt DateTime?
  lastSyncedAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, updatedAt])
  @@map("payment_attempts")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model EmailOutbox {
  id               String       @id @default(uuid()) @db.Uuid
  registrationId   String       @unique @db.Uuid
  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  payloadEncrypted String?
  status           String       @default("pending")
  attempts         Int          @default(0)
  nextAttemptAt    DateTime     @default(now())
  firstAttemptAt   DateTime?
  leaseId          String?      @db.Uuid
  leaseExpiresAt   DateTime?
  providerId       String?
  sentAt           DateTime?
  createdAt        DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}
