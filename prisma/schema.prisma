generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AcademicEvent {
  id           String   @id @db.Uuid
  title        String
  priceInCents Int
  capacity     Int
  status       String   @default("draft")
  createdAt    DateTime @default(now())

  @@map("academic_events")
}

enum UserRole {
  admin
  organizer
}

model User {
  id           String   @id @db.Uuid
  name         String
  email        String   @unique
  role         UserRole
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("users")
}